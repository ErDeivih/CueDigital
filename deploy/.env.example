# ─────────────────────────────────────────────────────────────────────────────
# EJEMPLO de la configuración de despliegue de CUE Digital.
#
# ESTE FICHERO NO LLEVA NINGÚN SECRETO DE VERDAD: todos los valores son de relleno.
# Se copia a `deploy/.env` (que está en .gitignore) y se cambia uno a uno:
#
#     cp deploy/.env.example deploy/.env
#
# Y `deploy/.env` NO se sube al repositorio, ni se pega en un chat, ni se copia a un
# correo. OJO: la regla `.env.*` del .gitignore de este repositorio también ignora
# este ejemplo; para que viaje con el código hay que hacer `git add -f`
# (o añadir antes una excepción en .gitignore). Está avisado en deploy/LEEME.md.
# ─────────────────────────────────────────────────────────────────────────────

# ─── El dominio público ──────────────────────────────────────────────────────
# Tiene que apuntar ya (registro A) a la IP del servidor ANTES de arrancar Caddy:
# si no, Caddy no puede pedir el certificado. Se usa un dominio de ejemplo que
# termina en `.invalid` a propósito: así no existe y no se pide nada por error.
DOMINIO=cuaderno.ejemplo.invalid

# ─── La base de datos (PostgreSQL en la misma máquina) ───────────────────────
POSTGRES_DB=cuedigital
POSTGRES_USER=cuedigital
# Clave larga y aleatoria. La misma de arriba y de abajo, porque es la misma cuenta.
POSTGRES_PASSWORD=CAMBIAR_clave-larga-de-la-base

# OJO: si la clave lleva @ : / ? # & hay que escribirla CODIFICADA PARA URL dentro de
# esta dirección (%40 para @, %3A para :, …). O más fácil: no uses esos caracteres.
CUEDIGITAL_DATABASE_URL=postgresql+psycopg://cuedigital:CAMBIAR_clave-larga-de-la-base@db:5432/cuedigital

# ─── La clave que firma los vales de sesión ──────────────────────────────────
# 48 bytes aleatorios, generados así (no se inventa):
#
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Si falta, el programa genera una distinta en cada arranque: las sesiones se caen al
# reiniciar y, con varios procesos, unos vales no valdrían en otros. Si cambia, todo el
# mundo tiene que volver a entrar. No caduca sola: ver docs/DESPLIEGUE.md.
CUEDIGITAL_SECRETO=CAMBIAR_por_48_bytes_aleatorios

# ─── Dónde viven los ficheros y la base en el servidor ───────────────────────
# Fuera del repositorio. Tiene que existir y ser del usuario 10001 (el del contenedor):
#     sudo mkdir -p /srv/cuedigital/datos/{adjuntos,sigpac_cache,postgresql}
#     sudo chown -R 10001:10001 /srv/cuedigital/datos
CARPETA_DATOS=/srv/cuedigital/datos

# ─── Iteraciones de la clave (mínimo de verdad: 100000) ──────────────────────
# 240000 es el valor por defecto del programa (backend/app/security.py). Solo se baja
# en los tests, y allí hace falta además CUEDIGITAL_ENTORNO=pruebas.
CUEDIGITAL_ITERACIONES_PBKDF2=240000

# ─── NO PONER ESTO EN PRODUCCIÓN ─────────────────────────────────────────────
# `pruebas` permite bajar las iteraciones de la clave. En el servidor de verdad, nunca.
# CUEDIGITAL_ENTORNO=pruebas

# ─── Entrar con el certificado digital (opcional) ────────────────────────────
# SOLO se enciende cuando haya un proxy DELANTE que valide el certificado (hoy, Caddy,
# y está preparado pero NO probado: ver deploy/Caddyfile). Si se enciende sin eso,
# cualquiera puede mandar la cabecera y entrar como otro agricultor.
# CUEDIGITAL_CONFIAR_EN_CABECERAS=1

# ─── IUWS: el volcado a la Junta (opcional) ──────────────────────────────────
# Hacen falta el certificado y su clave. Vacío = no configurado, y el programa lo dice
# en la pantalla en vez de inventarse una respuesta.
# CUEDIGITAL_IUWS_CERTIFICADO=/srv/cuedigital/certificados/iuws.pem
# CUEDIGITAL_IUWS_CLAVE=/srv/cuedigital/certificados/iuws-clave.pem

# ─── Copias de seguridad (las lee deploy/copia.sh, no la aplicación) ─────────
# DESTINO_COPIAS=/srv/cuedigital/copias
# DIAS_DE_COPIAS=14
# Con `rclone` instalado y un remoto configurado, la copia sale de la máquina:
# COPIA_REMOTA=r2:cuedigital-copias
